@using Microsoft.AspNetCore.Components.Routing
@inherits LayoutComponentBase
@implements IDisposable
@inject AppStateService AppStateService
@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IBrowserViewportService BrowserViewportService

<MudThemeProvider Theme="@AppTheme.For(AppStateService.SelectedCompetition)" IsDarkMode="@AppStateService.IsDarkMode"/>

@* Markenfarben des gewählten Wettbewerbs für die eigenen Styles (app.css) *@
<style>
    :root {
        --ft-primary: @(AppStateService.SelectedCompetition.PrimaryColor);
        --ft-primary-dark: @(AppStateService.SelectedCompetition.PrimaryDarkColor);
        --ft-primary-light: @(AppStateService.SelectedCompetition.PrimaryLightColor);
        --ft-compare-second: @(AppStateService.SelectedCompetition.ChartColors[1]);
    }
</style>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Fixed="true" Class="@(AppStateService.IsDarkMode ? "ft-appbar ft-appbar-dark" : "ft-appbar")">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@AppStateService.DrawerToggle" />

        <a href="" class="d-flex align-center gap-3 ft-brand">
            <span class="@($"ft-brand-logo {(AppStateService.SelectedCompetition.LogoIsWordmark ? "wordmark" : "")}")" title="@AppStateService.SelectedCompetition.Name">
                <img src="@AppStateService.SelectedCompetition.LogoUrl" alt="@AppStateService.SelectedCompetition.ShortName" />
                @if (AppStateService.SelectedCompetition.LogoIsWordmark)
                {
                    <span class="ft-brand-logo-short">@AppStateService.SelectedCompetition.LogoShortText</span>
                }
            </span>
            <MudHidden Breakpoint="Breakpoint.Xs">
                <div class="d-flex flex-column">
                    <span class="ft-brand-title">Football Tracker</span>
                    <span class="ft-brand-subtitle">By Lucas Nagelsmann</span>
                </div>
            </MudHidden>
        </a>

        <MudSpacer />

        <!-- Competition Selector -->
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="mr-1">
            <ActivatorContent>
                <MudHidden Breakpoint="Breakpoint.Xs">
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" EndIcon="@Icons.Material.Filled.ExpandMore" Class="ft-competition-button"
                               StartIcon="@Icons.Material.Filled.EmojiEvents">
                        @AppStateService.SelectedCompetition.ShortName
                    </MudButton>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.SmAndUp">
                    <MudIconButton Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Inherit" />
                </MudHidden>
            </ActivatorContent>
            <ChildContent>
                <MudText Typo="Typo.overline" Class="px-4 pt-2 mud-text-secondary d-block">Wettbewerb</MudText>
                @foreach (var competition in Competition.All)
                {
                    <MudMenuItem OnClick="@(() => AppStateService.SetCompetition(competition))"
                                 Icon="@(competition == AppStateService.SelectedCompetition ? Icons.Material.Filled.Check : null)">
                        @competition.Name
                    </MudMenuItem>
                }
            </ChildContent>
        </MudMenu>

        <!-- Season Selector -->
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="mr-1">
            <ActivatorContent>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" EndIcon="@Icons.Material.Filled.ExpandMore" Class="ft-season-button">
                    @AppStateService.SelectedSeason.Name
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                @foreach (var season in AppStateService.Saisons)
                {
                    <MudMenuItem OnClick="@(() => AppStateService.SetSeason(season))"
                                 Icon="@(season.Year == AppStateService.SelectedSeason.Year ? Icons.Material.Filled.Check : null)">
                        Saison @season.Name
                    </MudMenuItem>
                }
            </ChildContent>
        </MudMenu>

        <!-- Dark Mode Toggle -->
        <MudTooltip Text="@(AppStateService.IsDarkMode ? "Heller Modus" : "Dunkler Modus")">
            <MudIconButton Icon="@(AppStateService.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="@AppStateService.ToggleDarkMode" />
        </MudTooltip>

        <!-- Account -->
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            <ActivatorContent>
                @if (AuthService.IsLoggedIn)
                {
                    <MudAvatar Size="Size.Small" Class="ft-account-avatar ml-1">@UserInitial</MudAvatar>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" />
                }
            </ActivatorContent>
            <ChildContent>
                @if (AuthService.IsLoggedIn)
                {
                    <MudText Typo="Typo.caption" Class="px-4 py-2 mud-text-secondary d-block">@AuthService.CurrentUser?.Email</MudText>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Person" Href="profile">Profil</MudMenuItem>
                }
                else
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Login" OnClick="OpenAuthDialog">Login / Registrieren</MudMenuItem>
                }
                <MudMenuItem Icon="@Icons.Material.Filled.Tune" Href="Settings">Einstellungen</MudMenuItem>
                @if (AuthService.IsLoggedIn)
                {
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Logout</MudMenuItem>
                }
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <!-- Navigation Drawer -->
    <MudDrawer @bind-Open="AppStateService.IsDrawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Variant="@DrawerVariant.Responsive"
               Class="ft-drawer">
        <MudNavMenu Class="pa-2" Rounded="true" Margin="Margin.Dense" Color="Color.Primary">
            <MudText Typo="Typo.overline" Class="px-4 pt-2 mud-text-secondary d-block">Übersicht</MudText>
            <MudNavLink Href="" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">Dashboard</MudNavLink>
            <MudNavLink Href="live" Icon="@Icons.Material.Filled.LiveTv">
                <div class="d-flex align-center justify-space-between">
                    <span>Live Scores</span>
                    <span class="ft-live-dot ml-2"></span>
                </div>
            </MudNavLink>
            <MudNavLink Href="Tabelle" Icon="@(AppStateService.SelectedCompetition.IsCup ? Icons.Material.Filled.AccountTree : Icons.Material.Filled.TableChart)">@(AppStateService.SelectedCompetition.IsCup ? "Turnierverlauf" : "Tabelle")</MudNavLink>
            <MudNavLink Href="Spieltage" Icon="@Icons.Material.Filled.CalendarMonth">@(AppStateService.SelectedCompetition.IsCup ? "Runden" : "Spieltage")</MudNavLink>
            <MudNavLink Href="Teams" Icon="@Icons.Material.Filled.Groups">Teams</MudNavLink>
            <MudNavLink Href="GoalGetters" Icon="@Icons.Material.Filled.SportsSoccer">Torschützen</MudNavLink>

            <MudText Typo="Typo.overline" Class="px-4 pt-4 mud-text-secondary d-block">Statistiken</MudText>
            <MudNavLink Href="statistiken/tore" Icon="@Icons.Material.Filled.QueryStats">Torstatistiken</MudNavLink>
            <MudNavLink Href="statistiken/performance" Icon="@Icons.Material.Filled.TrendingUp">Performance</MudNavLink>
            <MudNavLink Href="statistiken/vergleich" Icon="@Icons.Material.Filled.CompareArrows">Team-Vergleich</MudNavLink>

            <MudText Typo="Typo.overline" Class="px-4 pt-4 mud-text-secondary d-block">Favoriten</MudText>
            <MudNavLink Href="FavSpieler" Icon="@Icons.Material.Filled.Star">Player Tracker</MudNavLink>
            <MudNavLink Href="favoriten/teams" Icon="@Icons.Material.Filled.Favorite">Lieblingsteams</MudNavLink>
        </MudNavMenu>

        <MudSpacer />
        <div class="pa-4 text-center">
            <MudDivider Class="mb-3" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Football Tracker v0.4</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Daten: OpenLigaDB • © 2026</MudText>
        </div>
    </MudDrawer>

    <!-- Main Content -->
    <MudMainContent Class="ft-main">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="px-3 px-md-6 py-4 py-md-6">
            <div class="content-wrapper">
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="exception">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">
                            <div class="d-flex align-center flex-wrap gap-3">
                                <span>Es ist ein unerwarteter Fehler aufgetreten: @exception.Message</span>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Inherit" OnClick="() => _errorBoundary?.Recover()">Erneut versuchen</MudButton>
                            </div>
                        </MudAlert>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code
{
    private ErrorBoundary? _errorBoundary;

    private string UserInitial => string.IsNullOrEmpty(AuthService.CurrentUser?.Email)
        ? "?"
        : AuthService.CurrentUser.Email[..1].ToUpperInvariant();

    protected override void OnInitialized()
    {
        AppStateService.OnChange += OnStateChanged;
        AuthService.AuthStateChanged += OnStateChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Auf Smartphones startet das Menü geschlossen
        if (firstRender && await IsSmallScreen() && AppStateService.IsDrawerOpen)
            AppStateService.DrawerToggle();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _errorBoundary?.Recover();
        if (AppStateService.IsDrawerOpen && await IsSmallScreen())
            AppStateService.DrawerToggle();
    }

    private async Task<bool> IsSmallScreen()
    {
        try
        {
            var breakpoint = await BrowserViewportService.GetCurrentBreakpointAsync();
            return breakpoint is Breakpoint.Xs or Breakpoint.Sm;
        }
        catch
        {
            return false;
        }
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private Task OpenAuthDialog() => DialogService.ShowAsync<AuthDialog>(null, AuthDialog.Options);

    private async Task Logout()
    {
        var result = await AuthService.Logout();
        if (result.IsSuccess)
        {
            Snackbar.Add("Du wurdest abgemeldet.", Severity.Info);
            NavigationManager.NavigateTo("");
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Logout fehlgeschlagen", Severity.Error);
        }
    }

    public void Dispose()
    {
        AppStateService.OnChange -= OnStateChanged;
        AuthService.AuthStateChanged -= OnStateChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
