@using System.ComponentModel.DataAnnotations
<MudDialog Class="auth-dialog" ContentClass="pa-0" TitleClass="pa-0">
    <TitleContent>
        <div class="auth-dialog-header">
            <div class="auth-logo">
                <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Size="Size.Large" />
            </div>
            <MudText Typo="Typo.h5" Class="auth-title">
                @(IsLoginMode ? "Willkommen zurück" : "Konto erstellen")
            </MudText>
            <MudText Typo="Typo.body2" Class="auth-subtitle">
                @(IsLoginMode ? "Melde dich an, um Favoriten & Player Tracker zu nutzen" : "Erstelle jetzt dein kostenloses Konto")
            </MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="auth-content">

            @if (!AuthService.IsConfigured)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    Supabase ist in dieser Umgebung nicht konfiguriert. Login und Registrierung sind deaktiviert.
                </MudAlert>
            }

            <MudTabs @bind-ActivePanelIndex="_activeTab" Centered="true" Rounded="true"
                     Color="Color.Primary" Class="auth-tabs mb-4" PanelClass="pa-0">
                <MudTabPanel Text="Anmelden" Icon="@Icons.Material.Filled.Login" />
                <MudTabPanel Text="Registrieren" Icon="@Icons.Material.Filled.PersonAdd" />
            </MudTabs>

            @* LOGIN FORM *@
            @if (_activeTab == 0)
            {
                <MudForm @ref="_loginForm" @bind-IsValid="_loginValid" Class="auth-form">
                    <MudStack Spacing="3">

                        <MudTextField @bind-Value="_email"
                                      Label="E-Mail-Adresse"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Email"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email"
                                      AdornmentColor="Color.Primary"
                                      Required="true"
                                      RequiredError="E-Mail ist erforderlich"
                                      Validation="@(new EmailAddressAttribute { ErrorMessage = "Ungültige E-Mail-Adresse" })"
                                      Immediate="true"
                                      Class="auth-field" />

                        <MudTextField @bind-Value="_password"
                                      Label="Passwort"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showLoginPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showLoginPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="() => _showLoginPassword = !_showLoginPassword"
                                      Required="true"
                                      RequiredError="Passwort ist erforderlich"
                                      Immediate="true"
                                      OnKeyUp="OnLoginKeyUp"
                                      Class="auth-field" />

                        <div class="d-flex justify-end">
                            <MudLink Typo="Typo.caption" Color="Color.Primary" OnClick="HandleForgotPassword"
                                     Class="forgot-link" Style="cursor:pointer">
                                Passwort vergessen?
                            </MudLink>
                        </div>

                        @if (!string.IsNullOrEmpty(_loginError))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="rounded-lg">
                                @_loginError
                            </MudAlert>
                        }

                        @if (!string.IsNullOrEmpty(_infoMessage))
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="rounded-lg">
                                @_infoMessage
                            </MudAlert>
                        }

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   FullWidth="true"
                                   Disabled="@(!_loginValid || _isLoading || !AuthService.IsConfigured)"
                                   OnClick="HandleLogin"
                                   Class="auth-btn mt-2">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" Class="mr-2" />
                                <span>Anmelden...</span>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" />
                                <span>Anmelden</span>
                            }
                        </MudButton>

                        <MudDivider Class="my-2" />

                        <div class="d-flex justify-center">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                Noch kein Konto?
                                <MudLink OnClick="@(() => _activeTab = 1)" Typo="Typo.body2"
                                         Color="Color.Primary" Style="cursor:pointer; font-weight:600;">
                                    Jetzt registrieren
                                </MudLink>
                            </MudText>
                        </div>

                    </MudStack>
                </MudForm>
            }

            @* REGISTER FORM *@
            @if (_activeTab == 1)
            {
                <MudForm @ref="_registerForm" @bind-IsValid="_registerValid" Class="auth-form">
                    <MudStack Spacing="3">

                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_name"
                                              Label="Vorname"
                                              Variant="Variant.Outlined"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Person"
                                              AdornmentColor="Color.Primary"
                                              Required="true"
                                              RequiredError="Pflichtfeld"
                                              Immediate="true"
                                              Class="auth-field" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_lastName"
                                              Label="Nachname"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              RequiredError="Pflichtfeld"
                                              Immediate="true"
                                              Class="auth-field" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_username"
                                              Label="Username"
                                              Variant="Variant.Outlined"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.AlternateEmail"
                                              AdornmentColor="Color.Primary"
                                              Required="true"
                                              RequiredError="Pflichtfeld"
                                              Immediate="true"
                                              Class="auth-field" />
                            </MudItem>
                        </MudGrid>

                        <MudTextField @bind-Value="_email"
                                      Label="E-Mail-Adresse"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Email"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email"
                                      AdornmentColor="Color.Primary"
                                      Required="true"
                                      RequiredError="E-Mail ist erforderlich"
                                      Validation="@(new EmailAddressAttribute { ErrorMessage = "Ungültige E-Mail-Adresse" })"
                                      Immediate="true"
                                      Class="auth-field" />

                        <MudTextField @bind-Value="_password"
                                      Label="Passwort"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showRegPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showRegPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="() => _showRegPassword = !_showRegPassword"
                                      Required="true"
                                      RequiredError="Passwort ist erforderlich"
                                      Validation="@((string val) => val.Length >= 8 ? null : "Mindestens 8 Zeichen")"
                                      HelperText="Mindestens 8 Zeichen"
                                      Immediate="true"
                                      Class="auth-field" />

                        <MudTextField @bind-Value="_confirmPassword"
                                      Label="Passwort bestätigen"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="() => _showConfirmPassword = !_showConfirmPassword"
                                      Required="true"
                                      RequiredError="Bitte Passwort bestätigen"
                                      Validation="@((string val) => val == _password ? null : "Passwörter stimmen nicht überein")"
                                      Immediate="true"
                                      Class="auth-field" />

                        <MudCheckBox @bind-Value="_acceptTermsAndConditions"
                                     Required="true"
                                     RequiredError="Bitte bestätigen"
                                     Color="Color.Primary"
                                     Dense="true">
                            <MudText Typo="Typo.body2">
                                Ich bin einverstanden, dass meine Daten zur Nutzung der App gespeichert werden.
                            </MudText>
                        </MudCheckBox>

                        @if (!string.IsNullOrEmpty(_registerError))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="rounded-lg">
                                @_registerError
                            </MudAlert>
                        }

                        @if (_registerSuccess)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="rounded-lg">
                                Registrierung erfolgreich! Bitte bestätige deine E-Mail-Adresse und melde dich anschließend an.
                            </MudAlert>
                        }

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   FullWidth="true"
                                   Disabled="@(!_registerValid || _isLoading || !AuthService.IsConfigured)"
                                   OnClick="HandleRegister"
                                   Class="auth-btn mt-2">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" Class="mr-2" />
                                <span>Konto wird erstellt...</span>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-2" />
                                <span>Konto erstellen</span>
                            }
                        </MudButton>

                        <MudDivider Class="my-2" />

                        <div class="d-flex justify-center">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                Bereits registriert?
                                <MudLink OnClick="@(() => _activeTab = 0)" Typo="Typo.body2"
                                         Color="Color.Primary" Style="cursor:pointer; font-weight:600;">
                                    Jetzt anmelden
                                </MudLink>
                            </MudText>
                        </div>

                    </MudStack>
                </MudForm>
            }

        </div>
    </DialogContent>
</MudDialog>

<style>
    .auth-dialog {
        border-radius: 20px !important;
        overflow: hidden;
    }

    .auth-dialog-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 32px 24px 20px;
        background: linear-gradient(135deg, var(--ft-primary) 0%, var(--ft-primary-dark) 100%);
        color: white;
    }

    .auth-logo {
        width: 64px;
        height: 64px;
        background: rgba(255,255,255,0.18);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        border: 2px solid rgba(255,255,255,0.35);
        color: white;
    }

    .auth-title {
        color: white !important;
        font-weight: 700 !important;
        margin-bottom: 4px;
    }

    .auth-subtitle {
        color: rgba(255,255,255,0.85) !important;
    }

    .auth-content {
        padding: 20px 24px 24px;
    }

    .auth-field .mud-input-outlined-border {
        border-radius: 12px !important;
    }

    .auth-btn {
        border-radius: 12px !important;
        height: 48px;
        font-weight: 600 !important;
        text-transform: none !important;
        font-size: 1rem !important;
    }
</style>
