@page "/Tabelle"
@inherits SeasonPageBase
@inject TabellenService TabellenService
@inject GameService GameService
@inject FavoritesService FavoritesService
@inject NavigationManager NavigationManager

<PageTitle>@(Comp.IsCup ? "Turnierverlauf" : "Tabelle") • Football Tracker</PageTitle>

@if (Comp.IsCup)
{
    <PageHeader Title="Turnierverlauf" Subtitle="@($"{Comp.Name} • Saison {AppStateService.SelectedSeason.Name}")" Icon="@Icons.Material.Filled.EmojiEvents" />

    <DataState IsLoading="IsLoading" Error="@ErrorMessage" OnRetry="ReloadAsync">
        <CupRounds Games="_games" Competition="Comp" HighlightTeamIds="_favoriteTeamIds" />
    </DataState>
}
else
{
<PageHeader Title="Tabelle" Subtitle="@($"{Comp.Name} • Saison {AppStateService.SelectedSeason.Name}")" Icon="@Icons.Material.Filled.TableChart">
    <Actions>
        <MudToggleGroup T="string" Value="_view" ValueChanged="ChangeView" Color="Color.Primary" Size="Size.Small" Outlined="true" Delimiters="true">
            <MudToggleItem Value="@("gesamt")" Text="Gesamt" />
            <MudToggleItem Value="@("heim")" Text="Heim" />
            <MudToggleItem Value="@("auswaerts")" Text="Auswärts" />
        </MudToggleGroup>
    </Actions>
</PageHeader>

<MudPaper Class="ft-card pa-0 pa-md-2" Elevation="0" Outlined="true">
    <DataState IsLoading="IsLoading" Error="@ErrorMessage" OnRetry="ReloadAsync" IsEmpty="!_rows.Any()" EmptyTitle="Noch keine Tabelle verfügbar">
        <MudTable T="TableRow" Items="_rows" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.None"
                  OnRowClick="@(args => NavigationManager.NavigateTo($"TeamDetailsPage/{args.Item!.Team.Id}"))"
                  RowClass="ft-clickable" HorizontalScrollbar="true" Class="ft-table">
            <HeaderContent>
                <MudTh Style="width: 48px">#</MudTh>
                <MudTh>Team</MudTh>
                <MudTh Class="text-center">Sp</MudTh>
                <MudTh Class="text-center">S</MudTh>
                <MudTh Class="text-center">U</MudTh>
                <MudTh Class="text-center">N</MudTh>
                <MudTh Class="text-center">Tore</MudTh>
                <MudTh Class="text-center">Diff</MudTh>
                <MudTh Class="text-center">Pkt</MudTh>
                <MudTh Class="d-none d-md-table-cell">Form</MudTh>
                <MudTh Style="width: 48px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><span class="@($"ft-pos ft-pos-{TablePositions.GetZone(AppStateService.SelectedCompetition, context.Position, _rows.Count)}")">@context.Position</span></MudTd>
                <MudTd>
                    <div class="d-flex align-center gap-2">
                        <TeamLogo Url="@context.Team.LogoUrl" Name="@context.Team.Name" Size="26" />
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">@context.Team.Name</MudHidden>
                        <MudHidden Breakpoint="Breakpoint.MdAndUp">@context.Team.DisplayName</MudHidden>
                    </div>
                </MudTd>
                <MudTd Class="text-center">@context.Played</MudTd>
                <MudTd Class="text-center">@context.Won</MudTd>
                <MudTd Class="text-center">@context.Draw</MudTd>
                <MudTd Class="text-center">@context.Lost</MudTd>
                <MudTd Class="text-center ft-nowrap">@context.GoalsFor:@context.GoalsAgainst</MudTd>
                <MudTd Class="text-center">@(context.GoalDifference > 0 ? "+" : "")@context.GoalDifference</MudTd>
                <MudTd Class="text-center font-weight-bold">@context.Points</MudTd>
                <MudTd Class="d-none d-md-table-cell"><FormChips Form="@context.Form" /></MudTd>
                <MudTd><FavoriteButton Team="context.Team" Size="Size.Small" /></MudTd>
            </RowTemplate>
        </MudTable>
    </DataState>
</MudPaper>

<div class="d-flex flex-wrap gap-4 mt-3 px-1">
    @foreach (var (zone, label) in TablePositions.Legend(AppStateService.SelectedCompetition))
    {
        <div class="d-flex align-center gap-2">
            <span class="@($"ft-legend ft-pos-{zone}")"></span>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@label</MudText>
        </div>
    }
</div>

@if (!IsLoading && string.IsNullOrEmpty(ErrorMessage) && _playedMatchDays > 0)
{
    <MudPaper Class="ft-card pa-4 pa-md-5 mt-5" Elevation="0" Outlined="true">
        <div class="d-flex align-center flex-wrap gap-3 mb-3">
            <div class="flex-grow-1">
                <MudText Typo="Typo.h6">Tabellenverlauf</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Tabellenplatz nach jedem Spieltag – bis zu @MaxProgressionTeams Teams vergleichen</MudText>
            </div>
            <MudSelect T="int" MultiSelection="true" SelectedValues="_progressionTeamIds" SelectedValuesChanged="OnProgressionTeamsChanged"
                       Label="Teams" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 260px; max-width: 420px"
                       MultiSelectionTextFunc="@(values => $"{values.Count} Teams ausgewählt")">
                @foreach (var team in _table)
                {
                    <MudSelectItem T="int" Value="team.Id">@team.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
        <PositionChart Series="_progressionSeries" MatchDays="_playedMatchDays" TeamCount="_table.Count" Competition="Comp" />
    </MudPaper>
}

@if (!IsLoading && _knockoutGames.Any())
{
    <MudText Typo="Typo.h5" Class="mt-6 mb-3">K.-o.-Phase</MudText>
    <CupRounds Games="_knockoutGames" Competition="Comp" HighlightTeamIds="_favoriteTeamIds" />
}
}

@code {
    private const int MaxProgressionTeams = 6;
    private Competition Comp => AppStateService.SelectedCompetition;
    private int[] _favoriteTeamIds = [];
    private List<Game> _knockoutGames = new();
    private record TableRow(int Position, Team Team, int Played, int Won, int Draw, int Lost, int GoalsFor, int GoalsAgainst, int Points, string Form)
    {
        public int GoalDifference => GoalsFor - GoalsAgainst;
    }

    private string _view = "gesamt";
    private List<Team> _table = new();
    private List<Game> _games = new();
    private List<TableRow> _rows = new();
    private int _playedMatchDays;
    private Dictionary<int, int[]> _positionHistory = new();
    private IEnumerable<int> _progressionTeamIds = [];
    private List<PositionChart.PositionSeries> _progressionSeries = new();

    protected override async Task LoadDataAsync()
    {
        _table = await TabellenService.GetTabelle(Season);
        var allGames = await GameService.GetSeasonGamesAsync(Season);
        // Tabelle und Verlauf nur aus der Ligaphase, K.-o.-Spiele werden separat angezeigt
        _games = Comp.IsCup ? allGames : allGames.Where(Comp.IsLeaguePhase).ToList();
        _knockoutGames = Comp.HasKnockout ? allGames.Where(g => !Comp.IsLeaguePhase(g)).ToList() : [];
        BuildRows();

        _playedMatchDays = GameService.GetPlayedMatchDays(_games);
        _positionHistory = StatisticsService.GetPositionHistory(_games, _playedMatchDays);

        // Vorauswahl: Lieblingsteams, sonst die Top 4
        await FavoritesService.EnsureLoadedAsync();
        _favoriteTeamIds = FavoritesService.Teams.Select(f => f.TeamId).ToArray();
        var tableIds = _table.Select(t => t.Id).ToHashSet();
        var favorites = FavoritesService.Teams.Select(f => f.TeamId).Where(tableIds.Contains).Take(MaxProgressionTeams).ToList();
        OnProgressionTeamsChanged(favorites.Any() ? favorites : _table.Take(4).Select(t => t.Id));
    }

    private void OnProgressionTeamsChanged(IEnumerable<int> teamIds)
    {
        _progressionTeamIds = teamIds.Take(MaxProgressionTeams).ToList();
        var teamsById = _table.ToDictionary(t => t.Id);
        _progressionSeries = _progressionTeamIds
            .Where(id => teamsById.ContainsKey(id) && _positionHistory.ContainsKey(id))
            .Select(id => new PositionChart.PositionSeries(teamsById[id].DisplayName, _positionHistory[id]))
            .ToList();
    }

    private void ChangeView(string view)
    {
        _view = view;
        BuildRows();
    }

    private void BuildRows()
    {
        if (_view == "gesamt")
        {
            _rows = _table
                .Select(t => new TableRow(t.TabellenPlatz, t, t.Spiele, t.Siege, t.Unentschieden, t.Niederlagen, t.Tore, t.Gegentore, t.Punkte, t.Form))
                .ToList();
            return;
        }

        var home = _view == "heim";
        var teamsById = _table.ToDictionary(t => t.Id);
        _rows = StatisticsService.BuildRecords(_games, (game, team) => game.IsHomeTeam(team.Id) == home)
            .Select((r, i) =>
            {
                var team = teamsById.GetValueOrDefault(r.Team.Id) ?? r.Team;
                var form = new string(_games
                    .Where(g => g.MatchIsFinished && g.Involves(team.Id) && g.IsHomeTeam(team.Id) == home)
                    .OrderBy(g => g.MatchDateTimeUtc)
                    .TakeLast(5)
                    .Select(g => g.GetOutcomeFor(team.Id) ?? '-')
                    .ToArray());
                return new TableRow(i + 1, team, r.Played, r.Won, r.Draw, r.Lost, r.GoalsFor, r.GoalsAgainst, r.Points, form);
            })
            .ToList();
    }
}
