@page "/"
@inherits SeasonPageBase
@inject GameService GameService
@inject StatisticsService StatisticsService
@inject TabellenService TabellenService

<PageTitle>Dashboard • Football Tracker</PageTitle>

<div class="ft-hero mb-5">
    <div class="ft-hero-content">
        <MudText Typo="Typo.overline" Class="ft-hero-overline">@Comp.Name</MudText>
        <MudText Typo="Typo.h3" Class="ft-hero-title">Saison @AppStateService.SelectedSeason.Name</MudText>
        <MudText Typo="Typo.body1" Class="ft-hero-text">
            @if (IsLoading)
            {
                <span>Daten werden geladen...</span>
            }
            else if (_cupWinner != null)
            {
                <span>@_cupWinner.Name hat @(Comp.IsCup ? "den" : "die") @Comp.Name gewonnen.</span>
            }
            else if (InKnockoutPhase && _teamsRemaining > 0)
            {
                <span>@Comp.RoundName(_currentMatchDay): noch @_teamsRemaining Teams im Wettbewerb.</span>
            }
            else if (_leader != null)
            {
                <span>@_leader.Name führt nach @_playedMatchDays Spieltagen mit @_leader.Punkte Punkten.</span>
            }
        </MudText>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <MudButton Href="live" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.LiveTv" Class="ft-hero-button">Live Scores</MudButton>
            <MudButton Href="FavSpieler" Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Star">Player Tracker</MudButton>
        </div>
    </div>
    <MudIcon Icon="@Icons.Material.Filled.SportsSoccer" Class="ft-hero-ball" />
</div>

<MudGrid Spacing="3" Class="mb-2">
    <MudItem xs="6" md="3">
        <StatCard Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Info" Label="@(InKnockoutPhase ? "Runde" : Comp.RoundLabel)"
                  Value="@(IsLoading ? "…" : InKnockoutPhase ? Comp.RoundName(_currentMatchDay) : $"{_currentMatchDay} / {GameService.MatchDaysPerSeason}")"
                  Hint="@(_liveGames > 0 ? $"{_liveGames} Spiele live" : null)" />
    </MudItem>
    <MudItem xs="6" md="3">
        <StatCard Icon="@Icons.Material.Filled.SportsSoccer" Color="Color.Success" Label="Tore gesamt" Value="@(IsLoading ? "…" : _totalGoals.ToString())" Hint="@(IsLoading ? null : $"{_goalsPerGame:0.00} pro Spiel")" />
    </MudItem>
    <MudItem xs="6" md="3">
        @if (InKnockoutPhase || _cupWinner != null)
        {
            <StatCard Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Label="@(_cupWinner != null ? (Comp.IsCup ? "Pokalsieger" : "Sieger") : "Teams im Wettbewerb")"
                      Value="@(_cupWinner?.DisplayName ?? (IsLoading ? "…" : _teamsRemaining.ToString()))" />
        }
        else
        {
            <StatCard Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Label="Tabellenführer" Value="@(_leader?.DisplayName ?? "–")" Hint="@(_leader != null ? $"{_leader.Punkte} Punkte" : null)" />
        }
    </MudItem>
    <MudItem xs="6" md="3">
        <StatCard Icon="@Icons.Material.Filled.Whatshot" Color="Color.Primary" Label="Top-Torschütze" Value="@(_topScorer?.Name ?? "–")" Hint="@(_topScorer != null ? $"{_topScorer.GoalCount} Tore" : null)" />
    </MudItem>
</MudGrid>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <MudAlert Severity="Severity.Warning" Class="mb-3">Einige Kennzahlen konnten nicht geladen werden: @ErrorMessage</MudAlert>
}

<MudGrid Spacing="3">
    <MudItem xs="12" lg="7">
        <Ergebnisse />
    </MudItem>
    <MudItem xs="12" lg="5">
        <MudStack Spacing="3">
            @if (Comp.IsCup)
            {
                <TopScorersCard />
            }
            else
            {
                <TableComponent Count="8" />
                <GamesChart />
            }
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private int _currentMatchDay;
    private int _playedMatchDays;
    private int _liveGames;
    private int _totalGoals;
    private double _goalsPerGame;
    private Team? _leader;
    private PlayerSeasonStats? _topScorer;
    private Team? _cupWinner;
    private int _teamsRemaining;

    private Competition Comp => AppStateService.SelectedCompetition;

    /// <summary>Pokal oder K.-o.-Phase der Champions League.</summary>
    private bool InKnockoutPhase => Comp.IsCup || (Comp.HasKnockout && _currentMatchDay > Comp.TableRounds);

    protected override async Task LoadDataAsync()
    {
        _leader = null;
        _topScorer = null;
        _cupWinner = null;
        var games = await GameService.GetSeasonGamesAsync(Season);
        _currentMatchDay = await GameService.GetCurrentMatchDay(Season);
        _playedMatchDays = GameService.GetPlayedMatchDays(games);
        _liveGames = games.Count(g => g.IsLive);

        if (Comp.HasKnockout)
        {
            // Teams der aktuellen Runde sind noch im Wettbewerb
            var currentRound = games.Where(g => g.MatchDay == _currentMatchDay).ToList();
            _teamsRemaining = currentRound.SelectMany(g => new[] { g.Team1.Id, g.Team2.Id }).Distinct().Count();
            var final = games.FirstOrDefault(g => g.MatchDay == Comp.RoundCount && g.MatchIsFinished);
            if (final != null)
                _cupWinner = final.GetOutcomeFor(final.Team1.Id) == 'S' ? final.Team1 : final.Team2;
        }

        var finished = games.Where(g => g.MatchIsFinished && g.RegulationResult != null).ToList();
        _totalGoals = finished.Sum(g => g.RegulationResult!.PointsTeam1 + g.RegulationResult.PointsTeam2);
        _goalsPerGame = finished.Count == 0 ? 0 : (double)_totalGoals / finished.Count;

        var table = await TabellenService.GetTabelle(Season);
        _leader = table.FirstOrDefault(t => t.Spiele > 0);
        _topScorer = (await StatisticsService.GetPlayerStatsAsync(Season)).FirstOrDefault();
    }
}
