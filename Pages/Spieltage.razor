@page "/Spieltage"
@inherits SeasonPageBase
@inject GameService GameService
@inject FavoritesService FavoritesService
@inject IJSRuntime JS

<PageTitle>Spieltage • Bundesliga Tracker</PageTitle>

<PageHeader Title="Spieltage" Subtitle="@($"Saison {AppStateService.SelectedSeason.Name} • 1. Fußball-Bundesliga")" Icon="@Icons.Material.Filled.CalendarMonth">
    <Actions>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="Refresh" Disabled="IsLoading">
            Aktualisieren
        </MudButton>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Today" Color="Color.Primary" OnClick="LoadCurrentMatchDay" Disabled="IsLoading">
            Aktueller Spieltag
        </MudButton>
    </Actions>
</PageHeader>

<!-- Spieltag-Auswahl -->
<MudPaper Class="ft-card pa-2 mb-4" Elevation="0" Outlined="true">
    <div class="d-flex align-center gap-1">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@(_selectedMatchDay <= 1 || IsLoading)" OnClick="() => SelectMatchDay(_selectedMatchDay - 1)" />
        <div class="ft-matchday-strip flex-grow-1">
            @foreach (var matchDay in Enumerable.Range(1, GameService.MatchDaysPerSeason))
            {
                var day = matchDay;
                <button class="@MatchDayClass(day)" @onclick="() => SelectMatchDay(day)" id="@($"md-{day}")">@day</button>
            }
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="@(_selectedMatchDay >= GameService.MatchDaysPerSeason || IsLoading)" OnClick="() => SelectMatchDay(_selectedMatchDay + 1)" />
    </div>
</MudPaper>

<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="6" md="3">
        <StatCard Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Info" Value="@($"{_selectedMatchDay}.")" Label="Spieltag" Hint="@(_selectedMatchDay == _currentMatchDay ? "aktuell" : null)" />
    </MudItem>
    <MudItem xs="6" md="3">
        <StatCard Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Value="@_allGames.Count(g => g.MatchIsFinished).ToString()" Label="Beendete Spiele" />
    </MudItem>
    <MudItem xs="6" md="3">
        <StatCard Icon="@Icons.Material.Filled.Schedule" Color="Color.Warning" Value="@_allGames.Count(g => g.IsUpcoming).ToString()" Label="Anstehende Spiele" />
    </MudItem>
    <MudItem xs="6" md="3">
        <StatCard Icon="@Icons.Material.Filled.SportsSoccer" Color="Color.Primary" Value="@_allGames.Sum(g => g.Goals.Count).ToString()" Label="Tore am Spieltag" Hint="@(_allGames.Any(g => g.IsLive) ? $"{_allGames.Count(g => g.IsLive)} live" : null)" />
    </MudItem>
</MudGrid>

<!-- Filter -->
<MudPaper Class="ft-card pa-4 mb-4" Elevation="0" Outlined="true">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="12" md="5">
            <MudToggleGroup T="string" @bind-Value="_selectedFilter" Color="Color.Primary" Size="Size.Small" Outlined="true" Delimiters="true" FixedContent="false">
                <MudToggleItem Value="@("all")" Text="Alle" />
                <MudToggleItem Value="@("live")" Text="Live" />
                <MudToggleItem Value="@("upcoming")" Text="Anstehend" />
                <MudToggleItem Value="@("finished")" Text="Beendet" />
            </MudToggleGroup>
        </MudItem>
        <MudItem xs="12" sm="7" md="4">
            <MudTextField @bind-Value="_searchTerm"
                          Placeholder="Team suchen"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="5" md="3">
            <MudSwitch T="bool" @bind-Value="_showOnlyFavorites" Label="Nur Lieblingsteams" Color="Color.Error" Disabled="!FavoritesService.IsLoggedIn" />
        </MudItem>
    </MudGrid>
</MudPaper>

<DataState IsLoading="IsLoading" Error="@ErrorMessage" OnRetry="ReloadAsync" IsEmpty="!FilteredGames.Any()"
           EmptyTitle="Keine Spiele gefunden" EmptyText="Versuche andere Filter oder Suchbegriffe.">
    <LoadingContent>
        <MudGrid Spacing="3">
            @for (var i = 0; i < 9; i++)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="220px" Class="rounded-lg" />
                </MudItem>
            }
        </MudGrid>
    </LoadingContent>
    <ChildContent>
        <MudGrid Spacing="3">
            @foreach (var game in FilteredGames)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <GameDetailCard Game="game" IsFavorite="IsFavoriteGame(game)" />
                </MudItem>
            }
        </MudGrid>
    </ChildContent>
</DataState>

<MudText Typo="Typo.caption" Align="Align.Center" Class="mud-text-secondary d-block mt-6">
    Daten von OpenLigaDB • Letzte Aktualisierung: @(GameService.LastUpdate?.ToString("dd.MM.yyyy HH:mm:ss") ?? "–")
</MudText>

@code {
    private List<Game> _allGames = new();
    private int _selectedMatchDay = 1;
    private int _currentMatchDay = 1;
    private string _selectedFilter = "all";
    private string _searchTerm = string.Empty;
    private bool _showOnlyFavorites;

    private List<Game> FilteredGames
    {
        get
        {
            var filtered = _selectedFilter switch
            {
                "live" => _allGames.Where(g => g.IsLive),
                "finished" => _allGames.Where(g => g.MatchIsFinished),
                "upcoming" => _allGames.Where(g => g.IsUpcoming),
                _ => _allGames.AsEnumerable()
            };

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                filtered = filtered.Where(g =>
                    g.Team1.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    g.Team1.ShortName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    g.Team2.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    g.Team2.ShortName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
            }

            if (_showOnlyFavorites)
                filtered = filtered.Where(IsFavoriteGame);

            return filtered.OrderBy(g => g.MatchDateTimeUtc).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        FavoritesService.Changed += OnFavoritesChanged;
        await base.OnInitializedAsync();
    }

    protected override async Task LoadDataAsync()
    {
        _currentMatchDay = await GameService.GetCurrentMatchDay(Season);
        _selectedMatchDay = _currentMatchDay;
        await FavoritesService.EnsureLoadedAsync();
        await LoadMatchDay();
    }

    private async Task LoadMatchDay(bool forceRefresh = false)
    {
        _allGames = await GameService.GetMatchDataAsync(Season, _selectedMatchDay, forceRefresh);
    }

    private Task SelectMatchDay(int matchDay)
    {
        _selectedMatchDay = Math.Clamp(matchDay, 1, GameService.MatchDaysPerSeason);
        return RunAsync(() => LoadMatchDay());
    }

    private Task Refresh() => RunAsync(() => LoadMatchDay(forceRefresh: true));

    private Task LoadCurrentMatchDay() => SelectMatchDay(_currentMatchDay);

    private bool IsFavoriteGame(Game game) =>
        FavoritesService.IsFavoriteTeam(game.Team1.Id) || FavoritesService.IsFavoriteTeam(game.Team2.Id);

    private string MatchDayClass(int day)
    {
        var css = "ft-matchday";
        if (day == _selectedMatchDay) css += " selected";
        if (day == _currentMatchDay) css += " current";
        return css;
    }

    private int _scrolledMatchDay;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Gewählten Spieltag in der Leiste sichtbar halten (v.a. auf dem Smartphone)
        if (!IsLoading && _scrolledMatchDay != _selectedMatchDay)
        {
            _scrolledMatchDay = _selectedMatchDay;
            await JS.InvokeVoidAsync("ftScrollIntoView", $"md-{_selectedMatchDay}");
        }
    }

    private void OnFavoritesChanged() => InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        FavoritesService.Changed -= OnFavoritesChanged;
        base.Dispose();
    }
}
