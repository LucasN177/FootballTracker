@* Prognose eines Spiels: Tipp, erwartete Tore und Sieg/Remis/Niederlage-Wahrscheinlichkeiten. *@

<MudPaper Class="ft-card pa-4 h-100" Elevation="0" Outlined="true">
    <div class="d-flex align-center justify-space-between mb-3">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Game.GetFormattedDateTime("ddd, dd.MM. HH:mm")</MudText>
        @if (Prediction.ActualScore is { } actual)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(Prediction.IsTendencyHit ? Color.Success : Color.Error)"
                     Icon="@(Prediction.IsTendencyHit ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)" Class="ma-0">
                Ergebnis @actual.Home:@actual.Away
            </MudChip>
        }
        else if (Game.IsLive)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Class="ma-0">Live @Game.GetScoreDisplay(":")</MudChip>
        }
    </div>

    <div class="ft-prediction-match">
        <div class="ft-prediction-team">
            <TeamLogo Url="@Game.Team1.LogoUrl" Name="@Game.Team1.Name" Size="40" />
            <a href="@($"TeamDetailsPage/{Game.Team1.Id}")" class="ft-prediction-team-name ft-two-lines">@Game.Team1.DisplayName</a>
            <FormChips Form="@HomeForm" />
        </div>
        <div class="ft-prediction-tip">
            <div class="ft-prediction-score">@Prediction.Tip.Home:@Prediction.Tip.Away</div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Tipp</MudText>
        </div>
        <div class="ft-prediction-team">
            <TeamLogo Url="@Game.Team2.LogoUrl" Name="@Game.Team2.Name" Size="40" />
            <a href="@($"TeamDetailsPage/{Game.Team2.Id}")" class="ft-prediction-team-name ft-two-lines">@Game.Team2.DisplayName</a>
            <FormChips Form="@AwayForm" />
        </div>
    </div>

    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block text-center mt-2">
        Erwartete Tore @Prediction.ExpectedGoalsHome.ToString("0.00") : @Prediction.ExpectedGoalsAway.ToString("0.00")
    </MudText>

    <div class="ft-wdl-bar ft-prediction-bar mt-3" title="Heimsieg / Remis / Auswärtssieg">
        <div class="win" style="@($"width:{Percent(Prediction.HomeWin)}%")"></div>
        <div class="draw" style="@($"width:{Percent(Prediction.Draw)}%")"></div>
        <div class="loss" style="@($"width:{Percent(Prediction.AwayWin)}%")"></div>
    </div>
    <div class="d-flex justify-space-between mt-1">
        <MudText Typo="Typo.caption" Class="@OutcomeClass(MatchOutcome.HomeWin)">Heim @Percent(Prediction.HomeWin) %</MudText>
        <MudText Typo="Typo.caption" Class="@OutcomeClass(MatchOutcome.Draw)">Remis @Percent(Prediction.Draw) %</MudText>
        <MudText Typo="Typo.caption" Class="@OutcomeClass(MatchOutcome.AwayWin)">Gast @Percent(Prediction.AwayWin) %</MudText>
    </div>

    <MudDivider Class="my-3" />
    <div class="d-flex align-center justify-space-between flex-wrap gap-1">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            Wahrscheinlichstes Ergebnis <b>@Prediction.MostLikelyScore.Home:@Prediction.MostLikelyScore.Away</b> (@Percent(Prediction.MostLikelyProbability) %)
        </MudText>
        @if (Prediction.KicktippPoints is { } points)
        {
            <MudText Typo="Typo.caption" Class="@(points > 0 ? "mud-success-text font-weight-bold" : "mud-text-secondary")">
                @(points == 1 ? "1 Punkt" : $"{points} Punkte")
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary" title="Erwartete Kicktipp-Punkte des Tipps">
                Ø @Prediction.TipExpectedPoints.ToString("0.00") Pkt.
            </MudText>
        }
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public MatchPrediction Prediction { get; set; } = null!;
    [Parameter] public string? HomeForm { get; set; }
    [Parameter] public string? AwayForm { get; set; }

    private Game Game => Prediction.Game;

    private static int Percent(double probability) => (int)Math.Round(probability * 100);

    private string OutcomeClass(MatchOutcome outcome) =>
        outcome == Prediction.PredictedOutcome ? "font-weight-bold" : "mud-text-secondary";
}
