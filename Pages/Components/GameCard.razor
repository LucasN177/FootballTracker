@* Kompakte Spielzeile, z.B. für Listen auf dem Dashboard. *@
@inject IDialogService DialogService

<div class="@($"ft-game-row {(Highlight ? "ft-game-row-highlight" : "")}")" @onclick="OpenDetails">
    <div class="ft-game-row-team">
        <span class="ft-ellipsis text-right">@Game.Team1.DisplayName</span>
        <TeamLogo Url="@Game.Team1.LogoUrl" Name="@Game.Team1.Name" Size="26" />
    </div>
    <div class="ft-game-row-score">
        @if (Game.IsUpcoming)
        {
            <span class="ft-game-row-time">@Game.GetFormattedDateTime(ShowDate ? "dd.MM. HH:mm" : "HH:mm")</span>
        }
        else
        {
            <span class="@($"ft-score-badge {(Game.IsLive ? "live" : "")}")">@Game.GetScoreDisplay(":")</span>
        }
        @if (Game.IsLive)
        {
            <span class="ft-live-dot" title="Live"></span>
        }
    </div>
    <div class="ft-game-row-team away">
        <TeamLogo Url="@Game.Team2.LogoUrl" Name="@Game.Team2.Name" Size="26" />
        <span class="ft-ellipsis">@Game.Team2.DisplayName</span>
    </div>
</div>

@code {
    [Parameter] public Game Game { get; set; } = new();
    [Parameter] public bool ShowDate { get; set; } = true;
    [Parameter] public bool Highlight { get; set; }

    private Task OpenDetails() => GameDetailsDialog.Show(DialogService, Game);
}
