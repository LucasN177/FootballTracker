@inject IDialogService DialogService

<MudCard Elevation="0" Outlined="true" Class="@($"ft-card ft-hover-lift game-card {(IsFavorite ? "game-card-favorite" : "")}")">
    <MudCardContent Class="pb-2">
        <div class="d-flex justify-space-between align-center mb-3">
            <MudChip T="string" Color="@Game.GetStatusColor()" Size="Size.Small"
                     Variant="@(Game.GetStatus() == GameStatus.Scheduled ? Variant.Outlined : Variant.Filled)"
                     Class="@($"ma-0 {(Game.IsLive ? "ft-pulse" : "")}")">
                @Game.GetGameStatus()
            </MudChip>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @Game.GetFormattedDateTime("ddd, dd.MM. • HH:mm")
            </MudText>
        </div>

        <div class="teams-container">
            <a class="team-section" href="@($"TeamDetailsPage/{Game.Team1.Id}")">
                <TeamLogo Url="@Game.Team1.LogoUrl" Name="@Game.Team1.Name" Size="52" />
                <MudText Typo="Typo.body2" Align="Align.Center" Class="font-weight-medium mt-1 ft-ellipsis">@Game.Team1.DisplayName</MudText>
            </a>

            <div class="score-section">
                <MudText Typo="Typo.h4" Align="Align.Center" Class="font-weight-bold" Color="@(Game.IsLive ? Color.Error : Color.Default)">
                    @Game.GetScoreDisplay(":")
                </MudText>
                @if (Game.HalfTimeResult != null)
                {
                    <MudText Typo="Typo.caption" Align="Align.Center" Class="mud-text-secondary d-block">
                        (@Game.HalfTimeResult.PointsTeam1:@Game.HalfTimeResult.PointsTeam2)
                    </MudText>
                }
                else if (Game.IsUpcoming)
                {
                    <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Info" Class="d-block">@Game.GetTimeUntil()</MudText>
                }
            </div>

            <a class="team-section" href="@($"TeamDetailsPage/{Game.Team2.Id}")">
                <TeamLogo Url="@Game.Team2.LogoUrl" Name="@Game.Team2.Name" Size="52" />
                <MudText Typo="Typo.body2" Align="Align.Center" Class="font-weight-medium mt-1 ft-ellipsis">@Game.Team2.DisplayName</MudText>
            </a>
        </div>

        @if (Game.Goals.Any())
        {
            <MudDivider Class="my-3" />
            <MudStack Spacing="1">
                @foreach (var goal in Game.Goals.Take(MaxGoals))
                {
                    <div class="goal-item d-flex justify-space-between align-center">
                        <MudText Typo="Typo.caption" Class="ft-ellipsis">
                            <strong>@(goal.MatchMinute?.ToString() ?? "?")'</strong> @(string.IsNullOrWhiteSpace(goal.GoalGetterName) ? "Unbekannt" : goal.GoalGetterName.Trim())
                            @if (goal.IsPenalty) { <span class="mud-info-text"> (11m)</span> }
                            @if (goal.IsOwnGoal) { <span class="mud-error-text"> (ET)</span> }
                        </MudText>
                        <MudText Typo="Typo.caption" Class="font-weight-bold">@goal.ScoreTeam1:@goal.ScoreTeam2</MudText>
                    </div>
                }
                @if (Game.Goals.Count > MaxGoals)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">+ @(Game.Goals.Count - MaxGoals) weitere Tore</MudText>
                }
            </MudStack>
        }
    </MudCardContent>

    <MudCardActions Class="justify-space-between pt-0">
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Info" Size="Size.Small"
                   OnClick="() => GameDetailsDialog.Show(DialogService, Game)">
            Details
        </MudButton>
        @if (Game.Location?.Stadium is { Length: > 0 } stadium)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary ft-ellipsis px-2">@stadium</MudText>
        }
    </MudCardActions>
</MudCard>

@code {
    private const int MaxGoals = 4;

    [Parameter] public Game Game { get; set; } = new();
    [Parameter] public bool IsFavorite { get; set; }
}

<style>
    .game-card {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .game-card-favorite {
        border-color: var(--mud-palette-error) !important;
        box-shadow: inset 4px 0 0 var(--mud-palette-error);
    }

    .teams-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .team-section {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 0;
        color: inherit;
        text-decoration: none;
    }

    .score-section {
        flex: 0 0 auto;
        text-align: center;
        min-width: 84px;
    }

    .goal-item {
        padding: 2px 8px;
        border-left: 3px solid var(--mud-palette-primary);
        border-radius: 4px;
        background: var(--mud-palette-action-default-hover);
    }
</style>
