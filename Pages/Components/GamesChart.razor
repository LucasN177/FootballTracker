@* Team-Schnellansicht für das Dashboard *@
@inherits SeasonPageBase
@inject TabellenService TabellenService
@inject FavoritesService FavoritesService

<MudPaper Class="ft-card pa-4 pa-md-5" Elevation="0" Outlined="true">
    <div class="d-flex align-center gap-2 mb-3">
        <MudIcon Icon="@Icons.Material.Filled.Insights" Color="Color.Info" />
        <MudText Typo="Typo.h6" Class="font-weight-bold">Team-Check</MudText>
    </div>

    <DataState IsLoading="IsLoading" Error="@ErrorMessage" OnRetry="ReloadAsync" IsEmpty="!_teams.Any()" EmptyTitle="Keine Teams verfügbar">
        <MudSelect T="Team" Value="_selectedTeam" ValueChanged="SelectTeam" Label="Team auswählen" Variant="Variant.Outlined" Margin="Margin.Dense"
                   ToStringFunc="@(t => t?.Name ?? string.Empty)">
            @foreach (var team in _teams)
            {
                <MudSelectItem T="Team" Value="@team">
                    <div class="d-flex align-center gap-2">
                        <TeamLogo Url="@team.LogoUrl" Name="@team.Name" Size="22" />
                        <span>@team.Name</span>
                    </div>
                </MudSelectItem>
            }
        </MudSelect>

        @if (_selectedTeam is { } team)
        {
            <div class="d-flex align-center gap-3 mt-4">
                <TeamLogo Url="@team.LogoUrl" Name="@team.Name" Size="56" />
                <div class="flex-grow-1" style="min-width: 0">
                    <MudLink Href="@($"TeamDetailsPage/{team.Id}")" Typo="Typo.h6" Color="Color.Inherit" Class="ft-ellipsis d-block">@team.Name</MudLink>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Platz @team.TabellenPlatz • @team.Punkte Punkte</MudText>
                </div>
                <FavoriteButton Team="team" />
            </div>

            <MudGrid Spacing="2" Class="mt-2">
                <MudItem xs="12" sm="5" Class="d-flex justify-center align-center">
                    @if (team.Spiele > 0)
                    {
                        <MudChart ChartType="ChartType.Donut" InputData="@_chartData" InputLabels="@ChartLabels"
                                  Width="170px" Height="170px" ChartOptions="@_chartOptions"></MudChart>
                    }
                </MudItem>
                <MudItem xs="12" sm="7">
                    <MudStack Spacing="2">
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.body2">Form</MudText>
                            <FormChips Form="@team.Form" />
                        </div>
                        <div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2">Tore pro Spiel</MudText>
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@PerGame(team.Tore)</MudText>
                            </div>
                            <MudProgressLinear Color="Color.Success" Value="@GoalShare(team.Tore)" Rounded="true" Size="Size.Small" Class="mt-1" />
                        </div>
                        <div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.body2">Gegentore pro Spiel</MudText>
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@PerGame(team.Gegentore)</MudText>
                            </div>
                            <MudProgressLinear Color="Color.Error" Value="@GoalShare(team.Gegentore)" Rounded="true" Size="Size.Small" Class="mt-1" />
                        </div>
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.body2">Tordifferenz</MudText>
                            <MudText Typo="Typo.body2" Class="font-weight-bold" Color="@(team.Differenz >= 0 ? Color.Success : Color.Error)">
                                @(team.Differenz > 0 ? "+" : "")@team.Differenz
                            </MudText>
                        </div>
                    </MudStack>
                </MudItem>
            </MudGrid>

            @if (team.NextGame is { } next)
            {
                var opponent = next.GetOpponent(team.Id);
                <MudPaper Outlined="true" Class="pa-3 mt-3 d-flex align-center gap-3" Elevation="0">
                    <MudText Typo="Typo.overline" Class="mud-text-secondary">Nächstes Spiel</MudText>
                    <TeamLogo Url="@opponent.LogoUrl" Name="@opponent.Name" Size="24" />
                    <MudText Typo="Typo.body2" Class="flex-grow-1 ft-ellipsis">@opponent.DisplayName</MudText>
                    <MudChip T="string" Size="Size.Small" Class="ma-0">@(next.IsHomeTeam(team.Id) ? "Heim" : "Auswärts")</MudChip>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@next.GetFormattedDateTime("dd.MM. HH:mm")</MudText>
                </MudPaper>
            }
        }
    </DataState>
</MudPaper>

@code {
    private static readonly string[] ChartLabels = ["Siege", "Remis", "Niederlagen"];
    private readonly ChartOptions _chartOptions = new() { ChartPalette = ["#2e7d32", "#f9a825", "#d32f2f"] };

    private List<Team> _teams = new();
    private Team? _selectedTeam;
    private double[] _chartData = [];

    protected override async Task LoadDataAsync()
    {
        _teams = await TabellenService.GetBundesligaTabelle(Season);
        await FavoritesService.EnsureLoadedAsync();

        // Bevorzugt das erste Lieblingsteam anzeigen
        var favoriteIds = FavoritesService.Teams.Select(t => t.TeamId).ToHashSet();
        SelectTeam(_teams.FirstOrDefault(t => favoriteIds.Contains(t.Id)) ?? _teams.FirstOrDefault());
    }

    private void SelectTeam(Team? team)
    {
        _selectedTeam = team;
        _chartData = team == null ? [] : [team.Siege, team.Unentschieden, team.Niederlagen];
    }

    private string PerGame(int goals) => _selectedTeam is { Spiele: > 0 } t ? ((double)goals / t.Spiele).ToString("0.00") : "–";

    private double GoalShare(int goals) =>
        _selectedTeam is { } t && t.Tore + t.Gegentore > 0 ? (double)goals / (t.Tore + t.Gegentore) * 100 : 0;
}
