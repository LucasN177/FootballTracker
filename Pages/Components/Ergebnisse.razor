@* Spieltags-Widget für das Dashboard *@
@inherits SeasonPageBase
@inject GameService GameService
@inject FavoritesService FavoritesService

<MudPaper Class="ft-card pa-4 pa-md-5" Elevation="0" Outlined="true">
    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">Spieltag</MudText>
            @if (_liveCount > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="ft-pulse ma-0">@_liveCount live</MudChip>
            }
        </div>
        <div class="d-flex align-center gap-1">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Disabled="@(_matchDay <= 1 || IsLoading)" OnClick="() => ChangeMatchDay(-1)" />
            <MudText Typo="Typo.body2" Class="font-weight-medium" Style="min-width: 92px; text-align: center">@_matchDay. Spieltag</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Disabled="@(_matchDay >= GameService.MatchDaysPerSeason || IsLoading)" OnClick="() => ChangeMatchDay(1)" />
            <MudTooltip Text="Aktualisieren">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Disabled="IsLoading" OnClick="Refresh" />
            </MudTooltip>
        </div>
    </div>

    <DataState IsLoading="IsLoading" Error="@ErrorMessage" OnRetry="ReloadAsync">
        <LoadingContent>
            @for (var i = 0; i < 6; i++)
            {
                <MudSkeleton Height="44px" Class="mb-1" />
            }
        </LoadingContent>
        <ChildContent>
            <MudTabs @bind-ActivePanelIndex="_activeTab" Color="Color.Transparent" SliderColor="Color.Primary" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-1" MinimumTabWidth="70px">
                <MudTabPanel Text="@($"Alle ({_games.Count})")">
                    <GamesList Games="_games" HighlightTeamIds="_favoriteTeamIds" />
                </MudTabPanel>
                <MudTabPanel Text="@($"Anstehend ({Upcoming.Count})")">
                    <GamesList Games="Upcoming" HighlightTeamIds="_favoriteTeamIds" EmptyText="Keine anstehenden Spiele" />
                </MudTabPanel>
                <MudTabPanel Text="@($"Beendet ({Finished.Count})")">
                    <GamesList Games="Finished" HighlightTeamIds="_favoriteTeamIds" EmptyText="Noch keine beendeten Spiele" />
                </MudTabPanel>
            </MudTabs>
        </ChildContent>
    </DataState>

    <MudDivider Class="my-3" />
    <MudText Typo="Typo.caption" Align="Align.Center" Class="mud-text-secondary d-block">
        Daten von OpenLigaDB • Stand @(GameService.LastUpdate?.ToString("HH:mm:ss") ?? "–")
    </MudText>
</MudPaper>

@code {
    private int _matchDay;
    private int _activeTab;
    private List<Game> _games = new();
    private int[] _favoriteTeamIds = [];
    private int _liveCount;

    private List<Game> Upcoming => _games.Where(g => !g.MatchIsFinished).ToList();
    private List<Game> Finished => _games.Where(g => g.MatchIsFinished).ToList();

    protected override async Task LoadDataAsync()
    {
        _matchDay = await GameService.GetCurrentMatchDay(Season);
        await LoadMatchDay();
    }

    private async Task LoadMatchDay(bool forceRefresh = false)
    {
        _games = await GameService.GetMatchDataAsync(Season, _matchDay, forceRefresh);
        _liveCount = _games.Count(g => g.IsLive);
        await FavoritesService.EnsureLoadedAsync();
        _favoriteTeamIds = FavoritesService.Teams.Select(t => t.TeamId).ToArray();
    }

    private async Task ChangeMatchDay(int delta)
    {
        _matchDay = Math.Clamp(_matchDay + delta, 1, GameService.MatchDaysPerSeason);
        await RunAsync(() => LoadMatchDay());
    }

    private Task Refresh() => RunAsync(() => LoadMatchDay(forceRefresh: true));
}
