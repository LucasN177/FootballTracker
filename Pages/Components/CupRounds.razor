@* Turnierverlauf eines Pokalwettbewerbs: alle Runden mit ihren Begegnungen, neueste Runde zuerst. *@

@if (!Games.Any())
{
    <MudText Class="mud-text-secondary py-8" Align="Align.Center">Für diese Saison liegen noch keine Pokalspiele vor.</MudText>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var round in Games.GroupBy(g => g.MatchDay).OrderByDescending(g => g.Key))
        {
            var games = round.OrderBy(g => g.MatchDateTimeUtc).ToList();
            <MudItem xs="12" md="@(games.Count > 4 ? 12 : 6)">
                <MudPaper Class="ft-card pa-4" Elevation="0" Outlined="true">
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.h6">@Competition.RoundName(round.Key)</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0">
                            @games.Count(g => g.MatchIsFinished) / @games.Count Spiele
                        </MudChip>
                    </div>
                    <div class="@(games.Count > 4 ? "ft-cup-round-grid" : "")">
                        @foreach (var game in games)
                        {
                            <div class="ft-cup-game">
                                <GameCard Game="game" Highlight="HighlightTeamIds.Contains(game.Team1.Id) || HighlightTeamIds.Contains(game.Team2.Id)" />
                                @if (game.GetPenaltyShootoutDisplay() is { } penalties)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block text-center">@penalties</MudText>
                                }
                            </div>
                        }
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter] public List<Game> Games { get; set; } = new();
    [Parameter] public Competition Competition { get; set; } = Competition.DfbPokal;
    [Parameter] public IReadOnlyCollection<int> HighlightTeamIds { get; set; } = Array.Empty<int>();
}
